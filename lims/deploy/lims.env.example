# /opt/lims/.env 예시 — supervisord(export한 셸에서 실행)와 scripts/backup.sh가 읽는 환경변수
# 값에 공백·따옴표·% 를 쓰지 마세요(supervisord 설정 확장과 백업 스크립트가 그대로 읽습니다).
LIMS_PORT=8610
LIMS_DB_PASSWORD=change-me
LIMS_DATABASE_URL=postgresql+psycopg://lims:change-me@localhost:5432/lims
LIMS_FILES_DIR=/data/lims/files
LIMS_VAR_DIR=/data/lims/var
# 세션 서명 키 (필수, 32자 이상). 이 예시 값 그대로면 기동을 거부합니다.
# 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
LIMS_SECRET_KEY=change-me-to-a-long-random-string
LIMS_MAX_UPLOAD_MB=200
# 대표값은 가장 최근 측정의 출처를 씀. 측정 시각이 같을 때만 이 순위로 고름 (D-37)
LIMS_SOURCE_PRIORITY=test,lab,manual,pv
LIMS_BACKUP_TARGET=/mnt/nas/lims-backup
# ── 설계서 11.3 확인 필요 사항 (관리 > 시스템 설정에서 현재 값 확인) ──
LIMS_WATCH_DIRS=/mnt/equip/sem;/mnt/equip/xrd;/mnt/equip/gds
LIMS_WATCH_USER=admin
LIMS_PPT_TEMPLATE=/opt/lims/deploy/company_a4_landscape.pptx
LIMS_ENGRAVE_COLUMNS=short_id,datamatrix_text
LIMS_ENGRAVE_DELIMITER=,
LIMS_ENGRAVE_ENCODING=utf-8-sig
LIMS_ENGRAVE_HEADER=1
LIMS_LABEL_SIZE_MM=50x20
LIMS_LABEL_CODE=datamatrix
# ── 보안 ──
# HTTPS로 서비스하면 1 (세션 쿠키 Secure). HTTP 사내망이면 0
LIMS_COOKIE_SECURE=0
# /docs·/openapi.json API 목록 노출 (운영 기본 0)
LIMS_API_DOCS=0
